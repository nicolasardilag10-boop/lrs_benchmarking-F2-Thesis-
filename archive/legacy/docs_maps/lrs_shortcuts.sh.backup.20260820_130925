        "$C_BOLD$C_CYAN" "$C_RESET"

    printf '%s==================%s\n\n' \
        "$C_CYAN" "$C_RESET"

    find "$WGS" \
        -maxdepth 1 \
        -type f \
        -name '*.smk' \
        -printf '%f\n' \
