    printf '  %s\n\n' "$FASTQ"

    printf 'Physical path:\n'
    printf '  %s\n\n' "$(readlink -f "$FASTQ")"

    find -L "$FASTQ" \
        -maxdepth 1 \
        -type f \
        -name '*.fastq.gz' \
        -printf '%f\n' \
        | sort

    printf '\n'
}


wgs-assemblies() {

    printf '\n'

    printf '%sASSEMBLY OUTPUTS%s\n' \
        "$C_BOLD$C_GREEN" "$C_RESET"

    printf '%s================%s\n\n' \
        "$C_GREEN" "$C_RESET"

    find "$ASSEMBLIES" \
        -maxdepth 4 \
        -type f \
        \( \
            -name '*.fa' \
            -o -name '*.fasta' \
            -o -name '*.log' \
        \) \
        -print \
        2>/dev/null \
        | sort

    printf '\n'
}


