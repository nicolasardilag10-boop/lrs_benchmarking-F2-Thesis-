# Verkko is currently branch-dependent.
# The production file may not exist on every branch.
edit-verkko() {

    local file="$WGS/hybrid.assembly.verkko.smk"

    if [[ -f "$file" ]]; then

        code "$file"

    else

        printf '\n%sVerkko production workflow is not present on this branch.%s\n' \
            "$C_YELLOW" "$C_RESET"

        printf 'Current branch: '

        git -C "$LRSACTIVE" branch --show-current

        printf '\nThe Verkko work exists on branch:\n'
        printf '  feature/wgs-verkko\n\n'

        printf 'You can inspect branches with:\n'
        printf '  lrs-branches\n\n'

    fi
}


edit-verkko-smoke() {

    local file="$WGS/hybrid.assembly.verkko.smoke.smk"

    if [[ -f "$file" ]]; then
        code "$file"
    else
        echo "Verkko smoke workflow not found on this branch."
    fi
}


# ==============================================================================
# INTERNAL GIT HELPERS
# ==============================================================================

_lrs_is_git() {

    git -C "$1" \
        rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1
}


_lrs_branch() {

    if _lrs_is_git "$1"; then

        git -C "$1" \
            branch \
            --show-current \
            2>/dev/null

    else

        printf 'not-git'

    fi
}


