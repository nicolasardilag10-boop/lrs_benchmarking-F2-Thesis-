# ==============================================================================
# LOCAL REPOSITORIES / WORKTREES
# ==============================================================================

lrs-repos() {

    local d

    printf '\n'

    printf '%sIMPORTANT LOCAL PROJECTS%s\n' \
        "$C_BOLD$C_CYAN" "$C_RESET"

    printf '%s========================%s\n' \
        "$C_CYAN" "$C_RESET"


    for d in \
        "$LRS" \
        "$LRSACTIVE" \
        "$LRSCHR21PR" \
        "$LRSCLEANPR" \
        "$LRSWGSOLD" \
        "$REPORT"
    do

        printf '\n%s\n' "$d"

        if _lrs_is_git "$d"; then

            printf '  Git:    %sYES%s\n' \
                "$C_GREEN" "$C_RESET"

            printf '  Branch: %s\n' \
                "$(_lrs_branch "$d")"

        else

            printf '  Git:    not detected\n'

        fi

    done

    printf '\n'
}


lrs-worktrees() {

    printf '\n'

    printf '%sGIT WORKTREES%s\n' \
        "$C_BOLD$C_YELLOW" "$C_RESET"

    printf '%s=============%s\n\n' \
        "$C_YELLOW" "$C_RESET"

    git -C "$LRSACTIVE" worktree list

    printf '\n'
}


# ==============================================================================
# GIT
# ==============================================================================

lrs-status() {

    git -C "$LRSACTIVE" status --short
}


lrs-current() {

    printf '\n'

    printf '%sACTIVE WGS GIT STATE%s\n' \
        "$C_BOLD$C_GREEN" "$C_RESET"

    printf '%s====================%s\n\n' \
        "$C_GREEN" "$C_RESET"

    printf 'Repository:\n'
    git -C "$LRSACTIVE" rev-parse --show-toplevel

    printf '\nBranch:\n'
    git -C "$LRSACTIVE" branch --show-current

    printf '\nLatest commit:\n'
    git -C "$LRSACTIVE" log -1 --oneline --decorate

    printf '\nStatus:\n'
    git -C "$LRSACTIVE" status --short

    printf '\n'
}


lrs-branches() {

    printf '\n'

    printf '%sLOCAL BRANCHES%s\n' \
        "$C_BOLD$C_YELLOW" "$C_RESET"

    git -C "$LRSACTIVE" branch -vv

    printf '\n'

    printf '%sREMOTE BRANCHES%s\n' \
        "$C_BOLD$C_YELLOW" "$C_RESET"

    git -C "$LRSACTIVE" branch -r

    printf '\n'
}


lrs-graph() {

    git -C "$LRSACTIVE" log \
        --graph \
        --decorate \
        --oneline \
        --all \
        -30
}


lrs-merged() {

    printf '\n'

    printf '%sMERGED INTO upstream/main%s\n' \
        "$C_BOLD$C_GREEN" "$C_RESET"

    git -C "$LRSACTIVE" \
        branch \
        -r \
        --merged upstream/main

    printf '\n'

    printf '%sNOT MERGED INTO upstream/main%s\n' \
        "$C_BOLD$C_YELLOW" "$C_RESET"

    git -C "$LRSACTIVE" \
        branch \
        -r \
        --no-merged upstream/main

    printf '\n'
}


lrs-remotes() {

    git -C "$LRSACTIVE" remote -v
}


