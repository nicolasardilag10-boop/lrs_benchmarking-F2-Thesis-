    input:
        normalized=(
            f"{ROOT}/results/checkpoints/"
            "all_final_normalizations_complete.ok"
        ),
        summary=(
            f"{ROOT}/results/tables/"
            "final_normalized_inputs.tsv"
        ),
    output:
        f"{ROOT}/results/checkpoints/"
        "final_inputs_ready.ok"
    run:
        Path(output[0]).parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        Path(output[0]).write_text(
            "\n".join(
                [
                    "SIX MATCHED CHROMOSOME-21 INPUTS READY",
                    "Samples: HG002, HG003, HG004",
                    "Technologies: HiFi, ONT",
                    "Target coverage: 30x",
                    f"Summary: {Path(input.summary).resolve()}",
                    "STATUS: PASS",
                    "",
                ]
            ),
            encoding="utf-8",
        )


wildcard_constraints:
    sample="HG00[234]",
    technology="hifi|ont",
    window="[0-9]{3}"
